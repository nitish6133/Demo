# Nexus repository configuration
registry=https://your-nexus-url/repository/npm-group/
@your-org:registry=https://your-nexus-url/repository/npm-private/

# Authentication (use npm login or set these)
# //your-nexus-url/repository/npm-private/:_authToken=your-auth-token
# //your-nexus-url/repository/npm-private/:username=your-username
# //your-nexus-url/repository/npm-private/:_password=your-base64-password
# //your-nexus-url/repository/npm-private/:email=your-email