# Business Configuration
# Copy this file to .env and update with your actual values

# These values are already configured in src/config.ts
# Update them directly in that file

# Social Media Configuration
# YouTube: Get your playlist ID from YouTube and update in config.ts
# Format: https://www.youtube.com/embed/videoseries?list=YOUR_PLAYLIST_ID

# Instagram: Get embed code from Elfsight or LightWidget
# Update config.social.instagramWidgetScript in config.ts

# Google Maps: Get embed URL from Google Maps
# Update config.business.mapUrl in config.ts
